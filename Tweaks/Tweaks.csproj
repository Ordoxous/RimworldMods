<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <WorkshopReference Include="XmlExtensions" WorkshopId="2574315206" />
        <WorkshopReference Include="WVC_MoreMechanoidsWorkModes_Main" WorkshopId="2888380373" />
        <!-- Optional: its types are only touched from methods that run when the mod is active -->
        <WorkshopReference Include="BiotechPatch" WorkshopId="3461060466" />
        <!-- Optional, as above: MultiFloors (1.6 only), for shutdown zones on other levels -->
        <WorkshopReference Include="MultiFloors" WorkshopId="3384660931" />
    </ItemGroup>

    <!-- Optional, as above: Simple Sidearms carries the tools for work. Its folders are named v1.6, not 1.6, so it can't be a
         WorkshopReference. It declares no 1.7 support and loads its v1.6 folder. -->
    <ItemGroup>
        <Reference Include="SimpleSidearms">
            <HintPath>$(WorkshopDirectory)\927155256\v1.6\Assemblies\SimpleSidearms.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
