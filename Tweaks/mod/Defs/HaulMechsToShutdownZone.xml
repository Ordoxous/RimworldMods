<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Only takes mechs vanilla's HaulMechsToCharger finds no charger for, so the two never compete -->
  <WorkGiverDef>
    <defName>Ordo_HaulMechToShutdownZone</defName>
    <label>haul unpowered mechs to shutdown zones</label>
    <giverClass>Ordo.Tweaks.WorkGiver_HaulMechToShutdownZone</giverClass>
    <workType>Hauling</workType>
    <verb>haul</verb>
    <gerund>hauling</gerund>
    <priorityInType>89</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <canBeDoneByMechs>true</canBeDoneByMechs>
  </WorkGiverDef>

  <JobDef>
    <defName>Ordo_HaulMechToShutdownZone</defName>
    <driverClass>Ordo.Tweaks.JobDriver_HaulMechToShutdownZone</driverClass>
    <reportString>hauling TargetA to a shutdown zone</reportString>
  </JobDef>

  <!-- MultiFloors: carries a mech (TargetB) up or down the stairs to a shutdown zone on another level, for either hauling
       work giver. Changing level ends the job as it moves the hauler, so it keeps carrying the mech after the job and into
       the next, as MultiFloors' own MF_RescueToOtherLevel does. -->
  <JobDef MayRequire="telardo.MultiFloors">
    <defName>Ordo_CarryMechToOtherLevel</defName>
    <driverClass>Ordo.Tweaks.JobDriver_CarryMechToOtherLevel</driverClass>
    <reportString>carrying TargetB to a shutdown zone on another level</reportString>
    <casualInterruptible>false</casualInterruptible>
    <dropThingBeforeJob>false</dropThingBeforeJob>
    <carryThingAfterJob>true</carryThingAfterJob>
  </JobDef>

  <!-- MultiFloors: a mech to a free charger on another level, when vanilla's HaulMechsToCharger finds none on its level.
       Scanned before vanilla's (90) and both zone tweaks (90, 89); it never takes a mech vanilla would. -->
  <WorkGiverDef MayRequire="telardo.MultiFloors">
    <defName>Ordo_HaulMechToChargerOnOtherLevel</defName>
    <label>haul mechs to chargers on other levels</label>
    <giverClass>Ordo.Tweaks.WorkGiver_HaulMechToChargerOnOtherLevel</giverClass>
    <workType>Hauling</workType>
    <verb>haul</verb>
    <gerund>hauling</gerund>
    <priorityInType>91</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <canBeDoneByMechs>true</canBeDoneByMechs>
  </WorkGiverDef>

  <!-- The last stage of carrying a mech to a charger on another level: vanilla's HaulMechToCharger, starting with the mech
       already carried -->
  <JobDef MayRequire="telardo.MultiFloors">
    <defName>Ordo_DeliverMechToCharger</defName>
    <driverClass>Ordo.Tweaks.JobDriver_DeliverMechToCharger</driverClass>
    <reportString>hauling TargetA to TargetB</reportString>
  </JobDef>

</Defs>
