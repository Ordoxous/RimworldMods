<?xml version="1.0" encoding="utf-8" ?>

<Patch>

	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>Ordo.Tweaks</modId>
		<key>SmallUpgradesAtAdvancedAssembler</key>
		<defaultValue>true</defaultValue>
		<caseTrue>
			<Operation Class="XmlExtensions.Conditional">
				<xpath>Defs/ThingDef/recipeMaker/recipeUsers[li/text()="MU_BasicUpgradesAssembler"]</xpath>
				<caseTrue>
					<Operation Class="XmlExtensions.PatchOperationSafeAdd">
						<xpath>Defs/ThingDef/recipeMaker/recipeUsers[li/text()="MU_BasicUpgradesAssembler"]</xpath>
						<compare>InnerText</compare>
						<value>
							<li>MU_AdvancedUpgradesAssembler</li>
						</value>
					</Operation>
				</caseTrue>
			</Operation>
		</caseTrue>
	</Operation>

</Patch>
