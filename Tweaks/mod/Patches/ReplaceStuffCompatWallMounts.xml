<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Replace Stuff Compatibility swaps VEF's CompProperties_MountableOnWall for a copy of its own, with
    a copy of VEF's BlocksConstruction fix that only counts a wall when it's smoothed or its defName
    contains "wall". Odyssey's GravshipHull is neither, so a wall-mounted cooler, vent or heater placed
    on the hull is blocked by it, and the builder deconstructs the hull and the blueprint is then lost.
    VEF's own check also takes wall-linked edifices and supportsWallAttachments, so the comp goes back
    to VEF's, which brings back VEF's patches (blocking, can-construct, destroy-with-wall) for it.
  -->
  <Operation Class="XmlExtensions.FindMod">
    <mods>
      <li>Garethp.ReplaceStuffCompatibility</li>
    </mods>
    <packageId>true</packageId>
    <caseTrue>
      <Operation Class="XmlExtensions.FindMod">
        <mods>
          <li>OskarPotocki.VanillaFactionsExpanded.Core</li>
        </mods>
        <packageId>true</packageId>
        <caseTrue>
          <Operation Class="XmlExtensions.OptionalPatch">
            <modId>Ordo.Tweaks</modId>
            <key>VefWallMountsOnAnyWall</key>
            <defaultValue>true</defaultValue>
            <caseTrue>

              <Operation Class="PatchOperationReplace">
                <success>Always</success>
                <xpath>Defs/ThingDef/comps/li[@Class="Replace_Stuff_Compatibility.Comps.CompProperties_MountableOnWall"]</xpath>
                <value>
                  <li Class="VEF.Buildings.CompProperties_MountableOnWall"/>
                </value>
              </Operation>

            </caseTrue>
          </Operation>
        </caseTrue>
      </Operation>
    </caseTrue>
  </Operation>

</Patch>
