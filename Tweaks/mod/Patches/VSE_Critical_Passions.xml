<?xml version="1.0" encoding="utf-8" ?>

<Patch>

    <Operation Class="XmlExtensions.FindMod">
        <mods>
            <li>vanillaexpanded.skills</li>
        </mods>
        <packageId>true</packageId>
        <caseTrue>
            <Operation Class="XmlExtensions.UseSetting">
                <modId>Ordo.Tweaks</modId>
                <key>VseCriticalLearnRateOther</key>
                <defaultValue>0.75</defaultValue>
                <apply>
                    <Operation Class="XmlExtensions.PatchOperationSafeReplace">
                        <xpath>Defs/VSE.Passions.PassionDef[defName="VSE_Critical"]</xpath>
                        <compare>Name</compare>
                        <value>
                            <learnRateFactorOther>{VseCriticalLearnRateOther}</learnRateFactorOther>
                        </value>
                    </Operation>
                </apply>
            </Operation>
        </caseTrue>
    </Operation>

</Patch>
