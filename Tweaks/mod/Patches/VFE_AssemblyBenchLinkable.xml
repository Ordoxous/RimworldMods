<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="XmlExtensions.FindMod">
    <mods>
      <li>VanillaExpanded.VFEProduction</li>
    </mods>
    <packageId>true</packageId>
    <caseTrue>
      <Operation Class="XmlExtensions.OptionalPatch">
        <modId>Ordo.Tweaks</modId>
        <key>VfeBenchLinksFabricationCabinet</key>
        <defaultValue>true</defaultValue>
        <caseTrue>
          <Operation Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="VFE_ComponentFabricationBench"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
            <value>
              <li>VFE_FabricationCabinet</li>
            </value>
          </Operation>
        </caseTrue>
      </Operation>
    </caseTrue>
  </Operation>

</Patch>
