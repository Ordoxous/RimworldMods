<?xml version="1.0" encoding="utf-8" ?>

<Patch>

	<Operation Class="XmlExtensions.OptionalPatch">
		<modId>Ordo.Tweaks</modId>
		<key>MechExtraWorkTypes</key>
		<defaultValue>true</defaultValue>
		<caseTrue>

			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>FrozenSnowFox.ComplexJobs</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/ThingDef[defName="Mech_Lifter" or defName="VR_Construct_Lifter"]/race/mechEnabledWorkTypes</xpath>
						<value>
							<li Operation="SafeAdd" Compare="InnerText">FSFDeliver</li>
						</value>
					</Operation>

					<!-- Complex Jobs' merge work type is optional and off by default: its own patch adds the def only when enabled.
					     Naming it when it doesn't exist is a load error. Its patches run first, through loadAfter in About.xml -->
					<Operation Class="XmlExtensions.Conditional">
						<xpath>Defs/WorkTypeDef[defName="FSFMerge"]</xpath>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>Defs/ThingDef[defName="Mech_Lifter" or defName="VR_Construct_Lifter"]/race/mechEnabledWorkTypes</xpath>
								<value>
									<li Operation="SafeAdd" Compare="InnerText">FSFMerge</li>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</caseTrue>
			</Operation>

			<Operation Class="XmlExtensions.FindMod">
				<mods>
					<li>Zei33.SimpleImprove</li>
				</mods>
				<packageId>true</packageId>
				<caseTrue>
					<Operation Class="XmlExtensions.HybridPatch">
						<xpath>Defs/ThingDef[defName="Mech_Constructoid"]/race/mechEnabledWorkTypes</xpath>
						<value>
							<li Operation="SafeAdd" Compare="InnerText">WorkType_Improving</li>
						</value>
					</Operation>

					<Operation Class="XmlExtensions.Conditional">
						<xpath>Defs/ThingDef[defName="VR_Construct_Constructoid"]/race/mechEnabledWorkTypes</xpath>
						<caseTrue>
							<Operation Class="XmlExtensions.HybridPatch">
								<xpath>Defs/ThingDef[defName="VR_Construct_Constructoid"]/race/mechEnabledWorkTypes</xpath>
								<value>
									<li Operation="SafeAdd" Compare="InnerText">WorkType_Improving</li>
								</value>
							</Operation>
						</caseTrue>
					</Operation>
				</caseTrue>
			</Operation>

		</caseTrue>
	</Operation>

</Patch>
