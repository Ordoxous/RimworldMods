<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Elephant: already has abilities and specialTrainables from Odyssey's war trumpet -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/PawnKindDef[defName="Elephant"]/abilities</xpath>
    <value>
      <li>Ordo_TrunkBlast</li>
      <li>Ordo_TrunkThrow</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Elephant"]/race/specialTrainables</xpath>
    <value>
      <li>Ordo_TrunkBlast</li>
      <li>Ordo_TrunkThrow</li>
    </value>
  </Operation>

