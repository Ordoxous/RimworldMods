        <xpath>Defs/PawnKindDef[defName="Boomrat"]/abilities</xpath>
        <value>
          <li>Ordo_BoomratFireBurst</li>
        </value>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Boomrat"]/race/specialTrainables</xpath>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Boomrat"]/race</xpath>
