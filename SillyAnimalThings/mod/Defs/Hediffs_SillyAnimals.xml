<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>Ordo_Regenerating</defName>
    <label>regenerating</label>
    <description>Wounds are closing at a furious pace.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>True</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
      <li Class="Ordo.SillyAnimalThings.HediffCompProperties_Regenerate">
        <intervalTicks>60</intervalTicks>
        <healPerInterval>1</healPerInterval>
      </li>
    </comps>
  </HediffDef>

  <!-- Same invisibility as the psychic invisibility psycast, but it ends as soon as the tiger attacks -->
  <HediffDef>
    <defName>Ordo_HiddenDragon</defName>
    <label>hidden dragon</label>
    <description>Crouched low and impossible to see, waiting to pounce. Attacking will reveal this creature.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Invisibility">
        <visibleToPlayer>true</visibleToPlayer>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>True</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
      <li Class="Ordo.SillyAnimalThings.HediffCompProperties_RemoveOnAttack" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>Ordo_Rallied</defName>
    <label>rallied</label>
    <description>Stirred up by a rallying howl, fighting harder and moving faster.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>True</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <stages>
      <li>
        <statFactors>
          <MeleeDamageFactor>1.25</MeleeDamageFactor>
          <MoveSpeed>1.2</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Slows through MoveSpeed rather than the Moving capacity: a pawn with no Moving capacity counts as downed -->
  <HediffDef>
    <defName>Ordo_Withdrawn</defName>
    <label>withdrawn</label>
    <description>Pulled back into a protective shell. Very well armored, but barely able to move.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>True</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
          <ArmorRating_Blunt>1.2</ArmorRating_Blunt>
          <ArmorRating_Heat>0.6</ArmorRating_Heat>
        </statOffsets>
        <statFactors>
          <MoveSpeed>0.05</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Ordo_SpitInEyes</defName>
    <label>spit in eyes</label>
    <description>A foul wad of saliva in the eyes is making it hard to see.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900~900</disappearsAfterTicks>
        <showRemainingTime>True</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <postFactor>0.5</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
