<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Each tag gives its abilities to every pawn kind of its races, and adds the trainables those abilities require.
    To add another mod's animal, patch the race into a tag's races list, or add a new AnimalTagDef.
  -->

  <Ordo.SillyAnimalThings.AnimalTagDef>
    <defName>Ordo_Tag_Trunked</defName>
    <label>trunked</label>
    <abilities>
      <li>Ordo_TrunkBlast</li>
      <li>Ordo_TrunkThrow</li>
    </abilities>
    <races>
      <li>Elephant</li>
      <li>Mastodon</li>
    </races>
  </Ordo.SillyAnimalThings.AnimalTagDef>

  <Ordo.SillyAnimalThings.AnimalTagDef>
    <defName>Ordo_Tag_Woodchewer</defName>
    <label>woodchewer</label>
    <abilities>
