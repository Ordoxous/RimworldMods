    </abilities>
    <races>
      <li>Boomalope</li>
      <li>Boomrat</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Toxalope</li>
    </races>
  </Ordo.SillyAnimalThings.AnimalTagDef>

