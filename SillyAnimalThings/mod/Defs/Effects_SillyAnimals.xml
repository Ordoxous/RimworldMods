<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Howl: a small ring on each ally that heard it. Odyssey's war trumpet ring grows to fill the screen, which turns several
       of them into a smudge, so this copy stays close to the pawn. -->
  <ThingDef ParentName="MoteBase">
    <defName>Ordo_Mote_RallyRing</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <fadeOutTime>0.4</fadeOutTime>
      <solidTime>0.3</solidTime>
      <growthRate>3</growthRate>
    </mote>
    <graphicData>
      <graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
      <shaderType>MotePsychicWarmupNeuroquake</shaderType>
      <texPath>Things/Mote/MoteHellfireCannon_HeatWaveDistortion</texPath>
      <shaderParameters>
        <_distortionIntensity>0.5</_distortionIntensity>
        <_brightnessMultiplier>1.25</_brightnessMultiplier>
        <_distortionTint>(0, 0, 0.08, 0)</_distortionTint>
        <_pulseSpeed>1</_pulseSpeed>
      </shaderParameters>
      <drawSize>2</drawSize>
    </graphicData>
  </ThingDef>

  <EffecterDef>
    <defName>Ordo_RallyRing</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>Ordo_Mote_RallyRing</moteDef>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <!-- Intimidate: the base game's terror halo grows several cells wide, which over a scattering herd fills the screen. This copy
       stays close to the pawn it's on. -->
  <ThingDef ParentName="MoteBase">
    <defName>Ordo_Mote_TerrorHalo</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <mote>
      <fadeInTime>0.05</fadeInTime>
      <fadeOutTime>0.3</fadeOutTime>
      <solidTime>0.6</solidTime>
      <growthRate>1</growthRate>
    </mote>
    <graphicData>
      <texPath>Things/Mote/RadiationDistortion_A</texPath>
      <graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
      <color>(0.3, 0.3, 0.3, 1)</color>
      <shaderType>MoteMultiplyCircularGrayscale</shaderType>
      <shaderParameters>
        <_MultiplyTex>/Things/Mote/RadiationDistortion_B</_MultiplyTex>
        <_texAScale>0.2</_texAScale>
        <_texBScale>0.2</_texBScale>
        <_texAScrollSpeed>0.8</_texAScrollSpeed>
        <_texBScrollSpeed>-0.4</_texBScrollSpeed>
        <_texAScaleDist>0.5</_texAScaleDist>
        <_DistortionScale>0.6</_DistortionScale>
        <_Intensity>8</_Intensity>
      </shaderParameters>
      <drawSize>1.6</drawSize>
    </graphicData>
  </ThingDef>

  <!-- Withdraw: the shield belt's bubble, tinted like a shell, for as long as the animal is withdrawn -->
  <ThingDef ParentName="MoteBase">
    <defName>Ordo_Mote_Shell</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.2</fadeInTime>
      <solidTime>9999</solidTime>
      <fadeOutTime>0.3</fadeOutTime>
      <needsMaintenance>true</needsMaintenance>
    </mote>
    <graphicData>
      <texPath>Other/ShieldBubble</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.85, 0.65, 0.35, 0.8)</color>
      <drawSize>1.5</drawSize>
    </graphicData>
  </ThingDef>

  <!-- Gnaw: chewing sounds, and wood chips flying off the building while the animal winds up -->
  <EffecterDef>
    <defName>Ordo_Gnawing</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_Sustainer</subEffecterClass>
        <soundDef>Interact_ConstructWood</soundDef>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
        <fleckDef>HarvestWood</fleckDef>
        <spawnLocType>RandomCellOnTarget</spawnLocType>
        <ticksBetweenMotes>15</ticksBetweenMotes>
        <burstCount>3~5</burstCount>
        <scale>0.9~1.3</scale>
        <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
        <angle>0~360</angle>
        <speed>1.5~3</speed>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>DustPuff</fleckDef>
        <spawnLocType>RandomCellOnTarget</spawnLocType>
        <chancePerTick>0.06</chancePerTick>
        <scale>0.9~1.2</scale>
        <rotationRate>-60~60</rotationRate>
        <speed>0.6~1.8</speed>
      </li>
    </children>
  </EffecterDef>

</Defs>
