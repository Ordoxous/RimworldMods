    <iconPath>UI/Commands/WarTrumpet</iconPath>
    <cooldownTicksRange>7500</cooldownTicksRange> <!-- 3 hours -->
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <targetRequired>false</targetRequired>
    <displayOrder>300</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <statBases>
      <Ability_EffectRadius>14.9</Ability_EffectRadius>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <violent>false</violent>
      <range>14.9</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <drawAimPie>false</drawAimPie>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetMechs>false</canTargetMechs>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityRequiresTrainable">
        <trainableDef>Ordo_Howl</trainableDef>
      </li>
      <li Class="CompProperties_AbilityEffect">
        <compClass>Ordo.SillyAnimalThings.CompAbilityEffect_OnlyTargetAllies</compClass>
      </li>
      <li Class="CompProperties_AbilityAnimalRoar">
        <chanceFromHearingCurve>
          <points>
            <li>(0.0, 0.0)</li>
            <li>(0.8, 1.0)</li>
          </points>
        </chanceFromHearingCurve>
      </li>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>Ordo_Rallied</hediffDef>
        <replaceExisting>true</replaceExisting>
        <durationSecondsOverride>30~30</durationSecondsOverride>
      </li>
      <li Class="CompProperties_AbilityEffecterOnCaster">
        <effecterDef>WarTrumpet</effecterDef>
        <maintainTicks>20</maintainTicks>
      </li>
    </comps>
    <modExtensions>
      <li Class="Ordo.SillyAnimalThings.AutoCastExtension">
        <castWhenEnemyWithin>19.9</castWhenEnemyWithin>
      </li>
    </modExtensions>
  </AbilityDef>

