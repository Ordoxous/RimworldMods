<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Ordo.BridgeTools</AssemblyName>
        <!-- A RimBridgeServer companion, not a mod: no About.xml, and it deploys with DeployCompanion -->
        <IsRimWorldMod>false</IsRimWorldMod>
        <DeployTarget>DeployCompanion</DeployTarget>
    </PropertyGroup>

    <!-- The host bridge supplies this at runtime, and NuGet doesn't carry the version it ships, so compile against its copy:
         the Workshop RimBridgeServer (since 2.5.0; before, a local copy in RimWorld\Mods) -->
    <ItemGroup>
        <WorkshopReference Include="RimBridgeServer.Sdk" WorkshopId="3727949765" />
    </ItemGroup>

    <!-- The scenarios read every mod's types; the game loads the mods itself, so their DLLs stay out of this output -->
    <ItemGroup>
        <ProjectReference Include="..\..\*\*.csproj" Private="false" />
    </ItemGroup>

    <!-- The MultiFloors fork's scenarios live in its private repo, and are compiled in only when it's checked out -->
    <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\MultiFloors\tests')">
        <DefineConstants>$(DefineConstants);MULTIFLOORS_FORK</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\MultiFloors\tests')">
        <Compile Include="..\..\MultiFloors\tests\**\*.cs" Link="Scenarios\MultiFloors\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- MechUpgradesUi's scenarios read Mechanoid Upgrades' types -->
    <ItemGroup>
        <WorkshopReference Include="MechanoidUpgrades" WorkshopId="3365118555" />
    </ItemGroup>

    <!-- Companions load from the game's BridgeTools folder, not Mods -->
    <Target Name="DeployCompanion">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$([MSBuild]::NormalizeDirectory('$(DeployGameDirectory)', 'BridgeTools', 'Ordo'))" />
    </Target>

</Project>
