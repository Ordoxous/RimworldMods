<!--
    Compile against the installed game's assemblies instead of Krafs.Rimworld.Ref's reference stubs, so the IDE
    shows real method bodies when navigating or decompiling. Directory.Build.targets imports this file.

    Each assembly the package provides is swapped for the file of the same name in the install root (RimWorld 1.7
    on Waylith keeps them there, next to the .NET runtime's own DLLs, so only the package's names are swapped).
    The swap only happens when the installed version (Version.txt, "1.7.5014 rev1195") matches the package's
    (1.7.5014-unstable). Set UseStrictRimWorldVersionComparison to false to match on the minor version alone.
    Anything missing from the install root keeps the package's copy.

    Adapted from the file Krafs.Rimworld.Ref suggests copying. Its */Managed glob (Unity builds) and install
    auto-detection are left out; RimWorldDirectory comes from Directory.Build.props.
-->

<Project>

    <PropertyGroup>
        <UseStrictRimWorldVersionComparison Condition="'$(UseStrictRimWorldVersionComparison)' == ''">true</UseStrictRimWorldVersionComparison>
        <!-- Debug only: Release builds, which are what gets published, compile against the package as everyone else does -->
        <EnableLocalRimWorldReferences Condition="'$(EnableLocalRimWorldReferences)' == '' AND '$(Configuration)' == 'Debug'">true</EnableLocalRimWorldReferences>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RimWorldDirectory)' != ''">
        <LocalRimWorldDirectory>$([MSBuild]::NormalizeDirectory('$(RimWorldDirectory.Trim())'))</LocalRimWorldDirectory>
        <RimWorldVersionFile Condition="Exists('$(LocalRimWorldDirectory)Version.txt')">$(LocalRimWorldDirectory)Version.txt</RimWorldVersionFile>
    </PropertyGroup>

    <Target Name="ResolveLocalRimWorldVersion" Condition="'$(RimWorldVersionFile)' != ''">
        <ReadLinesFromFile File="$(RimWorldVersionFile)">
            <Output TaskParameter="Lines" ItemName="VersionFileLine"/>
        </ReadLinesFromFile>

        <PropertyGroup>
            <!-- Not RimWorldVersion: MSBuild names ignore case, so that would overwrite RimworldVersion from the props file -->
            <InstalledRimWorldVersion>$([System.String]::Copy('%(VersionFileLine.Identity)').Split(' ')[0])</InstalledRimWorldVersion>
            <InstalledRimWorldVersionMinor>$(InstalledRimWorldVersion.Split('.')[1])</InstalledRimWorldVersionMinor>
            <InstalledRimWorldVersionPatch>$(InstalledRimWorldVersion.Split('.')[2])</InstalledRimWorldVersionPatch>
        </PropertyGroup>

        <Message Text="RimWorld version: $(InstalledRimWorldVersion)" Importance="high"/>
    </Target>

    <Target Name="ResolveRimRefVersion">
        <PropertyGroup>
            <RimRefVersion>@(PackageReference->WithMetadataValue('Identity', 'Krafs.Rimworld.Ref')->'%(Version)')</RimRefVersion>
            <RimRefVersionMinor Condition="'$(RimRefVersion)' != ''">$(RimRefVersion.Split('.')[1])</RimRefVersionMinor>
            <RimRefVersionPatch Condition="'$(RimRefVersion)' != ''">$(RimRefVersion.Split('.')[2].Split('-')[0])</RimRefVersionPatch>
        </PropertyGroup>

        <Message Text="Krafs.Rimworld.Ref version: $(RimRefVersion)" Importance="high"/>
    </Target>

    <!-- After the package's compile assets become Reference items, before they are resolved -->
    <Target Name="UseLocalRimWorldReferences"
            AfterTargets="ResolveLockFileReferences"
            BeforeTargets="ResolveAssemblyReferences"
            DependsOnTargets="ResolveLocalRimWorldVersion;ResolveRimRefVersion"
            Condition="'$(EnableLocalRimWorldReferences)' == 'true'">
        <PropertyGroup>
            <RimWorldVersionsMatch Condition="'$(InstalledRimWorldVersionMinor)' != '' AND '$(InstalledRimWorldVersionMinor)' == '$(RimRefVersionMinor)' AND ('$(InstalledRimWorldVersionPatch)' == '$(RimRefVersionPatch)' OR '$(UseStrictRimWorldVersionComparison)' != 'true')">true</RimWorldVersionsMatch>
        </PropertyGroup>

        <ItemGroup Condition="'$(RimWorldVersionsMatch)' == 'true'">
            <_RimRefReference Include="@(Reference)" Condition="'%(Reference.NuGetPackageId)' == 'Krafs.Rimworld.Ref' AND Exists('$(LocalRimWorldDirectory)%(Filename)%(Extension)')"/>
            <Reference Remove="@(_RimRefReference)"/>
            <!-- The package's items carry a HintPath to the package's file, which the resolver would prefer -->
            <Reference Include="@(_RimRefReference->'$(LocalRimWorldDirectory)%(Filename)%(Extension)')" HintPath="$(LocalRimWorldDirectory)%(Filename)%(Extension)" Private="false"/>
        </ItemGroup>

        <PropertyGroup>
            <LocalRimWorldReferenced>false</LocalRimWorldReferenced>
            <LocalRimWorldReferenced Condition="'@(_RimRefReference)' != ''">true</LocalRimWorldReferenced>
        </PropertyGroup>
        <Message Text="Local RimWorld referenced: $(LocalRimWorldReferenced) (@(_RimRefReference->Count()) assemblies from $(LocalRimWorldDirectory))" Importance="high"/>
    </Target>

</Project>
