<Project>
    <!-- Settings for every project in the repo. Targets are in Directory.Build.targets, which is read after the .csproj. -->

    <!-- Optional and git-ignored: override SteamLibraryDirectory, RimWorldDirectory or RimWorldDebugDirectory for this machine -->
    <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

    <PropertyGroup>
        <SteamLibraryDirectory Condition="'$(SteamLibraryDirectory)' == ''">D:\SteamLibrary</SteamLibraryDirectory>
        <RimWorldDirectory Condition="'$(RimWorldDirectory)' == ''">$(SteamLibraryDirectory)\steamapps\common\RimWorld</RimWorldDirectory>
        <RimWorldDebugDirectory Condition="'$(RimWorldDebugDirectory)' == ''">G:\RimWorld_Debug</RimWorldDebugDirectory>
        <WorkshopDirectory>$(SteamLibraryDirectory)\steamapps\workshop\content\294100</WorkshopDirectory>

        <RimworldVersion>1.7</RimworldVersion>
        <!-- Used for Workshop dependencies that do not ship a $(RimworldVersion) folder yet -->
        <RimworldFallbackVersion>1.6</RimworldFallbackVersion>

        <!-- A project that isn't a mod (BridgeTools) sets this to false: no About.xml check and no mod/ files in its output -->
        <IsRimWorldMod Condition="'$(IsRimWorldMod)' == ''">true</IsRimWorldMod>
    </PropertyGroup>

    <PropertyGroup>
        <!-- The SDK only defaults this after reading this file, so set it here for the settings below to see it -->
        <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <OutputType>Library</OutputType>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
        <RootNamespace>Ordo.$(MSBuildProjectName)</RootNamespace>

        <!-- Every configuration builds to out/Assemblies, the mod's layout, with the PDB embedded for hot reload and the debugger -->
        <OutputPath>$(MSBuildProjectDirectory)\out\Assemblies</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <DebugType>embedded</DebugType>
        <!-- The SDK default is higher, which would surface warnings the code has never been built with -->
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" />
        <!-- Pinned so every project compiles against the same game build; raise it when the game updates -->
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5014-unstable" />
        <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="Assembly-CSharp" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="mod\**" />
    </ItemGroup>
</Project>
