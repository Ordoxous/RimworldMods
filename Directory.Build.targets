<Project>
    <!-- Targets for every project in the repo, read after the .csproj so they see its items and properties -->

    <Import Project="$(MSBuildThisFileDirectory)build\LocalRimWorldReferences.targets" />

    <PropertyGroup>
        <!-- The game folder CopyToRimworld deploys into; CopyToRimworldDebug swaps in RimWorldDebugDirectory -->
        <DeployGameDirectory Condition="'$(DeployGameDirectory)' == ''">$(RimWorldDirectory)</DeployGameDirectory>
        <!-- What deploying does; a project that isn't a mod names its own target (BridgeTools) -->
        <DeployTarget Condition="'$(DeployTarget)' == ''">DeployMod</DeployTarget>
        <ModOutputDirectory>$(MSBuildProjectDirectory)\out\</ModOutputDirectory>
        <ModRepositoryUrl>https://github.com/Ordoxous/RimworldMods/tree/master</ModRepositoryUrl>
        <ModAuthor>Ordoxous</ModAuthor>
        <ModAboutFile>$(MSBuildProjectDirectory)\mod\About\About.xml</ModAboutFile>
        <SharedSourceDirectory>$(MSBuildThisFileDirectory)shared\</SharedSourceDirectory>
        <!-- About.xml says whether the mod needs Harmony, so it also decides whether the Harmony helpers are compiled in -->
        <ModUsesHarmony Condition="'$(IsRimWorldMod)' == 'true' AND Exists('$(ModAboutFile)') AND $([System.IO.File]::ReadAllText('$(ModAboutFile)').Contains('brrainz.harmony'))">true</ModUsesHarmony>
    </PropertyGroup>

    <!-- Source files shared by the mods, compiled into each as internal types; see shared/ -->
    <ItemGroup Condition="'$(ModUsesHarmony)' == 'true'">
        <Compile Include="$(SharedSourceDirectory)Harmony\*.cs" Link="shared\%(Filename)%(Extension)" Shared="true" />
    </ItemGroup>

    <!--
        Workshop mods to compile against, by assembly name:
            <WorkshopReference Include="MechanoidUpgrades" WorkshopId="3365118555" />
        Resolves to the mod's $(RimworldVersion) Assemblies folder, or its $(RimworldFallbackVersion) one when it has no
        folder for this version yet. The game loads the mod itself, so the DLL stays out of the output.
    -->
    <Target Name="ResolveWorkshopReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'@(WorkshopReference)' != ''">
        <ItemGroup>
            <_WorkshopReference Include="@(WorkshopReference)">
                <HintPath>$(WorkshopDirectory)\%(WorkshopReference.WorkshopId)\$(RimworldVersion)\Assemblies\%(WorkshopReference.Identity).dll</HintPath>
                <FallbackHintPath>$(WorkshopDirectory)\%(WorkshopReference.WorkshopId)\$(RimworldFallbackVersion)\Assemblies\%(WorkshopReference.Identity).dll</FallbackHintPath>
            </_WorkshopReference>
            <_WorkshopReference Condition="!Exists('%(HintPath)')">
                <HintPath>%(FallbackHintPath)</HintPath>
            </_WorkshopReference>
        </ItemGroup>

        <Error Condition="'%(_WorkshopReference.WorkshopId)' == ''" Text="WorkshopReference %(_WorkshopReference.Identity) has no WorkshopId" />
        <Error Condition="!Exists('%(_WorkshopReference.HintPath)')" Text="Workshop mod %(_WorkshopReference.WorkshopId) has no %(_WorkshopReference.Identity).dll for $(RimworldVersion) or $(RimworldFallbackVersion) under $(WorkshopDirectory). Subscribe to it in Steam, or set SteamLibraryDirectory in Directory.Build.local.props." />

        <ItemGroup>
            <Reference Include="@(_WorkshopReference)" Private="false" />
        </ItemGroup>
    </Target>

    <!-- Puts the mod's files next to its assembly in out/, and removes any that were deleted from mod/ -->
    <Target Name="CopyModFiles" AfterTargets="PostBuildEvent" Condition="'$(IsRimWorldMod)' == 'true'">
        <ItemGroup>
            <_ModFile Include="$(MSBuildProjectDirectory)\mod\**\*" />
            <_ModFileInOutput Include="@(_ModFile->'$(ModOutputDirectory)%(RecursiveDir)%(Filename)%(Extension)')" />
            <_StaleModFile Include="$(ModOutputDirectory)**\*" Exclude="$(ModOutputDirectory)Assemblies\**\*;@(_ModFileInOutput)" />
        </ItemGroup>

        <Delete Files="@(_StaleModFile)" />
        <Copy SourceFiles="@(_ModFile)" DestinationFolder="$(ModOutputDirectory)%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>

    <!-- Builds, then deploys into the game. Stop the game first if the DLL changed: mods load only at startup. -->
    <Target Name="CopyToRimworld" DependsOnTargets="Build;$(DeployTarget)" />

    <!-- As CopyToRimworld, into the install at RimWorldDebugDirectory -->
    <Target Name="CopyToRimworldDebug" DependsOnTargets="UseRimWorldDebugDirectory;Build;$(DeployTarget)" />

    <Target Name="UseRimWorldDebugDirectory">
        <PropertyGroup>
            <DeployGameDirectory>$(RimWorldDebugDirectory)</DeployGameDirectory>
        </PropertyGroup>
    </Target>

    <Target Name="DeployMod">
        <PropertyGroup>
            <_ModDeployDirectory>$([MSBuild]::NormalizeDirectory('$(DeployGameDirectory)', 'Mods', '$(MSBuildProjectName)'))</_ModDeployDirectory>
        </PropertyGroup>
        <ItemGroup>
            <_BuiltModFile Include="$(ModOutputDirectory)**\*" />
        </ItemGroup>

        <RemoveDir Directories="$(_ModDeployDirectory)" />
        <Copy SourceFiles="@(_BuiltModFile)" DestinationFolder="$(_ModDeployDirectory)%(RecursiveDir)" />
        <Message Importance="high" Text="$(MSBuildProjectName) -> $(_ModDeployDirectory)" />
    </Target>

    <!-- Fails the build when About.xml breaks one of the rules in the repo README's Conventions -->
    <Target Name="CheckAboutXml" BeforeTargets="CoreCompile" Condition="'$(IsRimWorldMod)' == 'true' AND '$(DesignTimeBuild)' != 'true'">
        <CheckAboutXml
            AboutFile="$(ModAboutFile)"
            PackageId="Ordo.$(MSBuildProjectName)"
            Url="$(ModRepositoryUrl)/$(MSBuildProjectName)"
            Author="$(ModAuthor)"
            RimworldVersion="$(RimworldVersion)"
            SourceFiles="@(Compile->WithMetadataValue('Shared', ''))"
            XmlFiles="@(_ModXmlFile)" />
    </Target>

    <ItemGroup>
        <_ModXmlFile Include="$(MSBuildProjectDirectory)\mod\**\*.xml" Exclude="$(MSBuildProjectDirectory)\mod\About\**" />
    </ItemGroup>

    <UsingTask TaskName="CheckAboutXml" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <AboutFile Required="true" />
            <PackageId Required="true" />
            <Url Required="true" />
            <Author Required="true" />
            <RimworldVersion Required="true" />
            <SourceFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <XmlFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.Collections.Generic" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Using Namespace="System.Xml" />
            <Using Namespace="System.Xml.Linq" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                void Problem(XObject at, string message)
                {
                    var line = at is IXmlLineInfo info && info.HasLineInfo() ? info.LineNumber : 0;
                    var column = at is IXmlLineInfo info2 && info2.HasLineInfo() ? info2.LinePosition : 0;
                    Log.LogError(null, "ORDO001", null, AboutFile, line, column, 0, 0, "About.xml: " + message);
                }

                if (!File.Exists(AboutFile))
                {
                    Log.LogError(null, "ORDO001", null, AboutFile, 0, 0, 0, 0, "Every mod needs mod/About/About.xml");
                    return !Log.HasLoggedErrors;
                }

                var root = XDocument.Load(AboutFile, LoadOptions.SetLineInfo).Root;
                string Text(XElement parent, string name) => parent.Element(name)?.Value.Trim() ?? "";
                bool Same(string a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

                foreach (var name in new[] { "name", "description" })
                {
                    if (Text(root, name) == "")
                        Problem(root, $"<{name}> is missing or empty");
                }

                if (Text(root, "packageId") != PackageId)
                    Problem(root.Element("packageId") ?? (XObject)root, $"<packageId> must be {PackageId}");
                if (Text(root, "author") != Author)
                    Problem(root.Element("author") ?? (XObject)root, $"<author> must be {Author}");
                if (Text(root, "url") != Url)
                    Problem(root.Element("url") ?? (XObject)root, $"<url> must be {Url}");

                var versions = root.Element("supportedVersions")?.Elements("li").Select(li => li.Value.Trim()).ToList();
                if (versions == null || !versions.Contains(RimworldVersion))
                    Problem(root.Element("supportedVersions") ?? (XObject)root, $"<supportedVersions> must include {RimworldVersion}");

                var loadAfter = root.Element("loadAfter")?.Elements("li").Select(li => li.Value.Trim()).ToList() ?? new List<string>();
                var dependencies = root.Element("modDependencies")?.Elements("li").ToList() ?? new List<XElement>();
                foreach (var dependency in dependencies)
                {
                    var id = Text(dependency, "packageId");
                    if (id == "")
                    {
                        Problem(dependency, "a dependency has no <packageId>");
                        continue;
                    }
                    if (Text(dependency, "displayName") == "")
                        Problem(dependency, $"dependency {id} has no <displayName>");
                    // DLCs come with the game; anything else needs somewhere to get it from
                    if (!id.StartsWith("ludeon.", StringComparison.OrdinalIgnoreCase) && Text(dependency, "steamWorkshopUrl") == "" && Text(dependency, "downloadUrl") == "")
                        Problem(dependency, $"dependency {id} needs a <steamWorkshopUrl> or <downloadUrl>");
                    if (!loadAfter.Any(after => Same(after, id)))
                        Problem(dependency, $"dependency {id} must also be in <loadAfter>");
                }

                var sources = (SourceFiles ?? new Microsoft.Build.Framework.ITaskItem[0])
                    .Select(item => item.GetMetadata("FullPath"))
                    .Where(File.Exists)
                    .Select(path => (path, text: File.ReadAllText(path)))
                    .ToList();

                // Optional integrations: mods the XML guards with MayRequire(AnyOf), or the code checks with ModsConfig.IsActive.
                // They load in any order without this, but a patch of their defs needs them loaded first.
                var optional = new List<(string id, string file, int line)>();
                foreach (var item in XmlFiles ?? new Microsoft.Build.Framework.ITaskItem[0])
                {
                    var path = item.GetMetadata("FullPath");
                    XDocument xml;
                    try { xml = XDocument.Load(path, LoadOptions.SetLineInfo); }
                    catch (XmlException) { continue; }
                    foreach (var attribute in xml.Descendants().Attributes().Where(a => a.Name.LocalName == "MayRequire" || a.Name.LocalName == "MayRequireAnyOf"))
                    {
                        var line = ((IXmlLineInfo)attribute).LineNumber;
                        foreach (var id in attribute.Value.Split(','))
                            optional.Add((id.Trim(), path, line));
                    }
                }
                foreach (var (path, text) in sources)
                {
                    foreach (System.Text.RegularExpressions.Match match in System.Text.RegularExpressions.Regex.Matches(text, @"ModsConfig\.IsActive\(\s*""([^""]+)""\s*\)"))
                    {
                        var line = text.Take(match.Index).Count(c => c == '\n') + 1;
                        optional.Add((match.Groups[1].Value, path, line));
                    }
                }
                // DLCs always load before mods
                foreach (var group in optional.Where(o => o.id != "" && !o.id.StartsWith("ludeon.", StringComparison.OrdinalIgnoreCase) && !loadAfter.Any(after => Same(after, o.id))).GroupBy(o => o.id.ToLowerInvariant()))
                {
                    var first = group.First();
                    Log.LogError(null, "ORDO001", null, AboutFile, ((IXmlLineInfo)(root.Element("loadAfter") ?? root)).LineNumber, 0, 0, 0,
                        $"About.xml: {first.id} must be in <loadAfter>, since {Path.GetFileName(first.file)}:{first.line} integrates with it");
                }

                // Harmony is in every project's references, so About.xml is the only thing saying whether the mod needs it
                var usesHarmony = sources.Any(source => source.text.Contains("HarmonyLib"));
                var dependsOnHarmony = dependencies.Any(dependency => Same(Text(dependency, "packageId"), "brrainz.harmony"));
                if (usesHarmony && !dependsOnHarmony)
                    Problem(root.Element("modDependencies") ?? (XObject)root, "the code uses HarmonyLib, so brrainz.harmony must be a dependency");
                if (!usesHarmony && dependsOnHarmony)
                    Problem(root.Element("modDependencies") ?? (XObject)root, "brrainz.harmony is a dependency, but no code uses HarmonyLib");
            ]]></Code>
        </Task>
    </UsingTask>
</Project>
